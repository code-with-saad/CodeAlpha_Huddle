PORT=5000
# The database name (huddle_db) must be in the path, before the "?".
MONGODB_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Server-only. Never expose this to the client.
ABLY_API_KEY=

# Invitation emails through Gmail (free). Create an app password at https://myaccount.google.com/apppasswords
# (needs 2-step verification on the account). Leave empty to turn email invitations off.
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Huddle
# Public address of the client, used for links inside emails. Defaults to the first CLIENT_URL.
APP_URL=
# Where messages from the public contact form are delivered. Defaults to xyroxx02@gmail.com.
CONTACT_TO=
